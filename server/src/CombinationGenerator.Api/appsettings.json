{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*",
  "Sessions": {
    "SlidingExpirationMinutes": 30,
    "MaxSessions": 10000
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
